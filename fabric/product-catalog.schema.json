{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewsense.local/schemas/product-catalog.schema.json",
  "title": "ViewSense AI® Integration Product Catalog",
  "type": "object",
  "required": ["apiVersion", "kind", "products"],
  "properties": {
    "apiVersion": {"const": "fabric.viewsense.io/v1alpha1"},
    "kind": {"const": "ProductCatalog"},
    "products": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "capability", "mode", "readiness", "default", "helmPaths", "tests"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "capability": {"type": "string", "minLength": 1},
          "mode": {"enum": ["bundled", "adapter", "managed-dependency", "external"]},
          "readiness": {"enum": ["validated", "configuration-ready", "planned"]},
          "default": {"type": "boolean"},
          "helmPaths": {"type": "array", "items": {"type": "string"}},
          "tests": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "notes": {"type": "string"}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
