    "providers": [
      {"name": "mock-openai-compatible", "status": "bundled"},
      {"name": "openai-adapter", "status": "bundled"},
      {"name": "vllm", "status": "external"},
      {"name": "openai-compatible-external", "status": "external"}
    ]
  }
