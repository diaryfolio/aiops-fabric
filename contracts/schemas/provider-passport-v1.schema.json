{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://viewsense.local/schemas/provider-passport-v1.schema.json",
  "title": "ViewSense AI® Provider Passport v1",
  "type": "object",
  "required": ["name", "kind", "endpoint", "residencies", "data_classifications", "owner", "expires_at"],
  "properties": {
    "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9-]{0,62}$"},
    "kind": {"enum": ["llm", "embedding", "memory", "mcp", "workflow", "agent", "ingestion"]},
    "endpoint": {"type": "string", "format": "uri", "pattern": "^https://"},
    "protocols": {"type": "object", "additionalProperties": {"type": "string"}},
    "capabilities": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "residencies": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}},
    "data_classifications": {"type": "array", "minItems": 1, "maxItems": 32, "items": {"type": "string"}},
    "owner": {"type": "string", "minLength": 1, "maxLength": 128},
    "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
    "sbom_uri": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
    "provenance_uri": {"type": ["string", "null"], "format": "uri", "pattern": "^https://"},
    "status": {"enum": ["draft", "revoked"]},
    "expires_at": {"type": "string", "format": "date-time"}
  },
  "additionalProperties": false
}
